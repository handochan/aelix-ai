    },
    {
      "name": "an empty list is accepted",
      "rig": "full",
      "replay": false,
      "params": {
        "names": []
      },
      "data": {
        "type": "object",
        "required": [
          "activeTools"
        ],
        "properties": {
          "activeTools": {
            "type": "array",
            "const": []
          }
        }
      }
    },
    {
      "name": "a tool the run keeps off is refused",
      "rig": "full",
      "replay": false,
      "params": {
        "names": [
          "read",
          "find"
        ]
      },
      "error": {
        "type": "string",
        "minLength": 1,
        "pattern": "^Cannot turn on find: "
