    },
    {
      "name": "names that are not strings are refused",
      "rig": "full",
      "replay": false,
      "params": {
        "names": [
          1
        ]
      },
      "error": {
        "type": "string",
        "minLength": 1
      }
    },
    {
      "name": "refused during a turn",
      "rig": "turn",
      "replay": false,
      "params": {
        "names": [
          "read"
        ]
      },
      "error": {
        "type": "string",
        "const": "Runtime mutations require an idle session"
      }
    },
    {
      "name": "the server-ws shape",
      "rig": "bare",
      "replay": false,
      "params": {
        "names": [
          "alpha"
        ]
      },
      "data": {
        "type": "object",
        "required": [
          "activeTools"
        ],
        "properties": {
          "activeTools": {
            "type": "array",
            "const": [
              "alpha"
            ]
          }
        }
      }
    },
    {
      "name": "sets the child's tools",
      "rig": "child",
      "replay": true,
      "before": [
