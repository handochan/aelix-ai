                    "type": "integer"
                  },
                  "output": {
                    "type": "integer"
                  },
                  "cache_read": {
                    "type": "integer"
                  },
                  "cache_write": {
                    "type": "integer"
                  },
                  "cost": {
                    "type": "number"
                  },
                  "tokens": {
                    "type": "integer"
                  },
                  "turns": {
                    "type": "integer"
                  }
                }
              },
              "error": {
                "type": [
