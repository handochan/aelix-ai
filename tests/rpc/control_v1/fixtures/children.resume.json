              },
              "ok": {
                "type": "boolean",
                "const": true
              },
              "status": {
                "type": "string",
                "const": "ok"
              },
              "summary": {
                "type": "string",
                "const": "resumed: go on"
              },
              "truncated": {
                "type": "boolean"
              },
              "usage": {
                "type": "object",
                "required": [
                  "input",
