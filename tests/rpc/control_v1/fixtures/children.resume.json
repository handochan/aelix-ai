      "type": "string",
      "required": true
    }
  },
  "consumers": [],
  "cases": [
    {
      "name": "resumes an agent the model delegated",
      "since": "#836",
      "rig": "full",
      "replay": false,
      "params": {
        "id": "child-session-1",
        "task": "go on"
      },
      "sensitive": {
        "id": "no-such-agent",
        "task": "something else"
      },
      "data": {
        "type": "object",
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "type": "object",
            "required": [
              "id",
              "profile",
              "ok",
              "status",
              "summary",
              "truncated",
              "usage",
              "error",
              "exit_code",
              "stop_reason",
              "elapsed_ms",
              "dropped_tools",
              "details",
              "dropped_lines",
              "tool_trail",
              "session_id"
