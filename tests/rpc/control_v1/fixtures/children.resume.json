                "type": "string",
                "const": "child-session-1"
              }
            }
          }
        }
      }
    },
    {
      "name": "an instruction of 64512 bytes is accepted",
      "since": "#836",
      "rig": "full",
      "replay": false,
      "params": {
        "id": "child-session-1",
        "task": {
          "$gen": "text",
          "count": 64512,
          "char": "t"
        }
      },
      "data": {
        "type": "object",
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "type": "object",
            "required": [
              "ok",
              "session_id"
            ],
            "properties": {
              "ok": {
                "type": "boolean",
                "const": true
              },
              "session_id": {
                "type": "string",
                "const": "child-session-1"
              }
            }
          }
        }
      }
    },
    {
      "name": "an instruction of 64513 bytes is refused",
      "since": "#836",
      "rig": "full",
      "replay": false,
      "params": {
        "id": "child-session-1",
        "task": {
          "$gen": "text",
          "count": 64513,
          "char": "t"
        }
      },
      "error": {
        "type": "string",
        "const": "The instruction is 64513 bytes; a resume instruction may be at most 64512 bytes. Shorten it."
      }
    },
    {
      "name": "an agent a person started is refused",
      "since": "#836",
      "rig": "full",
      "replay": false,
      "params": {
        "id": "by-a-person",
        "task": "go on"
      },
      "error": {
        "type": "string",
        "minLength": 1,
        "pattern": "agents/run"
      }
    },
    {
      "name": "an unknown id is refused",
      "since": "#836",
      "rig": "full",
      "replay": false,
      "params": {
        "id": "no-such-agent",
        "task": "go on"
      },
      "error": {
        "type": "string",
        "minLength": 1,
        "pattern": "^Resume refused: no agent this conversation delegated has that id"
      }
    },
    {
      "name": "no id is refused",
      "since": "#836",
      "rig": "full",
      "replay": false,
      "params": {
        "task": "go on"
      },
      "error": {
        "type": "string",
        "const": "id must be a non-empty string: the agent's session id"
      }
    },
    {
      "name": "no task is refused",
      "since": "#836",
      "rig": "full",
      "replay": false,
      "params": {
        "id": "child-session-1"
      },
      "error": {
        "type": "string",
        "const": "task must be a non-empty string: the agent's next instruction"
      }
    },
    {
      "name": "a NUL in the task is refused",
      "since": "#836",
      "rig": "full",
      "replay": false,
      "params": {
        "id": "child-session-1",
        "task": "a\u0000b"
      },
      "error": {
        "type": "string",
        "minLength": 1,
        "pattern": "NUL"
      }
    },
    {
      "name": "a turn refuses children/resume",
      "since": "#836",
      "rig": "turn",
      "replay": false,
      "params": {
        "id": "child-session-1",
        "task": "go on"
      },
      "error": {
        "type": "string",
        "minLength": 1,
        "pattern": "idle"
      }
    },
    {
      "name": "cancelled by commands/cancel",
      "since": "#836",
      "rig": "full",
      "replay": false,
      "params": {},
      "method": "commands/cancel",
      "during": {
        "method": "children/resume",
        "params": {
          "id": "child-session-1",
          "task": "hold"
        },
        "wait_for": {
          "type": "rig",
          "event": "resume_entered"
        },
        "ended_by_case": true
      },
      "check": "cancelled_the_during_command",
      "data": {
        "type": "object",
        "required": [
          "cancelled",
          "method"
        ],
        "properties": {
          "cancelled": {
            "type": "boolean",
            "const": true
          },
          "method": {
            "type": "string",
            "const": "children/resume"
          }
        }
      }
    },
    {
      "name": "no delegation refuses",
      "since": "#836",
      "rig": "full",
      "replay": false,
      "setup": "no_subagents",
      "params": {
        "id": "child-session-1",
        "task": "go on"
      },
      "error": {
        "type": "string",
        "minLength": 1,
        "pattern": "Subagents are disabled"
      }
    },
    {
      "name": "a runtime that cannot resume refuses",
      "since": "#836",
      "rig": "full",
      "replay": false,
      "setup": "a_runtime_that_cannot_resume",
      "params": {
        "id": "child-session-1",
        "task": "go on"
      },
      "error": {
        "type": "string",
