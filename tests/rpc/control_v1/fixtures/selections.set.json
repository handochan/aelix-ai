{
  "contract": "control-v1",
  "method": "selections/set",
  "since": "v1",
  "hosts": [
    "cli-rpc"
  ],
  "requires": "selections",
  "frameType": "extension_ui_request",
  "params": {
    "kind": {
      "type": "string",
      "required": true,
      "enum": [
        "agent",
        "extension",
        "mcp",
        "skill",
        "tool"
      ]
    },
    "scope": {
      "type": "string",
      "required": false,
      "enum": [
        "global",
        "project"
      ],
      "absent": "allowed only with an empty changes: nothing is written, and what the files say now is applied"
    },
    "changes": {
      "type": "array",
      "required": true,
      "maxItems": 1024,
      "fields": {
        "key": {
          "type": "string",
          "required": true,
          "maxLength": 8192
        },
        "on": {
          "type": "boolean",
          "required": true
        }
      }
    }
  },
  "consumers": [],
  "cases": [
    {
      "name": "turns a skill off in the global file",
      "rig": "full",
      "replay": false,
      "params": {
        "kind": "skill",
        "scope": "global",
        "changes": [
          {
            "key": "fixture-skill",
            "on": false
          }
        ]
      },
      "sensitive": {
        "changes": [
          {
            "key": "fixture-skill",
            "on": true
          }
        ]
      },
      "data": {
        "type": "object",
        "required": [
          "kind",
          "scope",
          "effect",
          "written",
          "changed",
          "mismatches",
          "apply"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "skill"
          },
          "scope": {
            "type": [
              "string",
              "null"
            ],
            "const": "global"
          },
          "effect": {
            "type": "string",
            "enum": [
              "next_request",
              "reload",
              "restart"
            ],
            "open": true,
            "const": "next_request"
          },
          "written": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "changed": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "saved"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "saved": {
                  "type": "boolean"
                }
              }
            },
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "label",
                    "saved"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "const": "fixture-skill"
                    },
                    "saved": {
                      "type": "boolean",
                      "const": false
                    }
                  }
                }
              }
            ]
          },
          "mismatches": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "apply": {
            "type": "object",
            "required": [
              "applied",
              "deferred",
              "turnedOn",
              "turnedOff",
              "warning"
            ],
            "properties": {
              "applied": {
                "type": "boolean",
                "const": true
              },
              "deferred": {
                "type": "boolean",
                "const": false
              },
              "turnedOn": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "turnedOff": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "allOf": [
                  {
                    "contains": {
                      "type": "string",
                      "const": "fixture-skill"
                    }
                  }
                ]
              },
              "warning": {
                "type": "null",
                "const": null
              }
            }
          }
        }
      }
    },
